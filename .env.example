# Copy this file to .env and fill in the values. Never commit .env.

# --- Legacy telemetry database (Neon serverless PostgreSQL) ---
# Owner connection string from the Neon dashboard (Connect -> connection pooling OFF). Used only by setup scripts.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Read-only AI agent connection. Generated automatically by: python scripts/setup_security.py
# The deployed app needs this and AUDIT_DATABASE_URL only, never the owner DATABASE_URL.
AGENT_DATABASE_URL=

# Append-only audit log connection. Generated automatically by: python scripts/setup_audit.py
AUDIT_DATABASE_URL=

# --- SOP knowledge base (Pinecone, free Starter plan) ---
# app.pinecone.io -> API keys -> Create API key (starts with pcsk_)
PINECONE_API_KEY=

# --- LLM (Groq, free tier) ---
# console.groq.com -> API Keys -> Create API Key (starts with gsk_)
GROQ_API_KEY=
# Optional overrides (defaults shown). Both are free Groq models.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional prompt-injection classifier (free on Groq). Default shown.
# PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# --- Web app ---
# Password for the Audit Log page. Pick a long random value. Leave empty to disable the page.
AUDIT_PAGE_PASSWORD=
